# ============================================================
# Variables de entorno - NutriAsistente IA
# Copia este archivo como ".env" y completa tus propios valores.
# NUNCA subas el archivo ".env" real al repositorio (ver .gitignore).
# ============================================================

# Puerto en el que corre el servidor
PORT=3000

# --- IA local opcional: Ollama (sin API key) ---
OLLAMA_BASE_URL=http://localhost:11434
# Nombre exacto de un modelo instalado (ollama list). No se asume ni descarga ninguno.
# Vacío: SERVICIO_IA_NO_CONFIGURADO; la aplicación general sigue disponible.
OLLAMA_MODEL=
# Incluye conexión y lectura completa de la respuesta. La primera inferencia
# carga el modelo en memoria (con llama3.1 8B tomó ~22 s); 60000 evita TIMEOUT en frío.
OLLAMA_TIMEOUT_MS=60000

# --- Seguridad ---
# Secreto usado para firmar los tokens de sesion (JWT). Usa una cadena larga y aleatoria.
JWT_SECRET=genera_un_secreto_largo_y_aleatorio
# Llave de cifrado AES-256 para datos sensibles (condiciones medicas, alergias).
# Debe tener EXACTAMENTE 64 caracteres hexadecimales (32 bytes).
# Generarla con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=genera_64_caracteres_hexadecimales

# --- Datos iniciales (usados por npm run seed) ---
SEED_ADMIN_NOMBRE=Administrador NutriVida
SEED_ADMIN_CORREO=admin@nutrivida.com
SEED_ADMIN_PASSWORD=define_una_contrasena_segura

# --- PostgreSQL (FASE 2) ---
# Conservar json hasta completar importación y verificación; luego usar postgres.
PERSISTENCE_DRIVER=json
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# Base independiente, vacía y exclusiva para pruebas (distinta de DB_NAME).
DB_TEST_NAME=

# FASE 3: vacío = sin acceso CORS desde otros orígenes. Lista exacta separada por comas.
CORS_ORIGINS=
# production requiere HTTPS; desarrollo local permite HTTP.
NODE_ENV=development
